<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/experiment_title"
            android:textColor="@color/primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:text="@string/experiment_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <Button
            android:id="@+id/button_listview"
            style="@style/ExperimentButton"
            android:text="@string/demo_listview" />

        <Button
            android:id="@+id/button_dialog"
            style="@style/ExperimentButton"
            android:text="@string/demo_dialog" />

        <Button
            android:id="@+id/button_menu"
            style="@style/ExperimentButton"
            android:text="@string/demo_menu" />

        <Button
            android:id="@+id/button_action_mode"
            style="@style/ExperimentButton"
            android:text="@string/demo_action_mode" />

        <Button
            android:id="@+id/button_recycler"
            style="@style/ExperimentButton"
            android:text="@string/demo_recycler" />
    </LinearLayout>
</ScrollView>
